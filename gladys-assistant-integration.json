{
  "manifest_version": 1,
  "type": "device",
  "name": "Advantage Air",
  "description": {
    "en": "Control your Advantage Air MyAir, e-zone and MyPlace systems locally.",
    "fr": "Pilotez vos systèmes Advantage Air MyAir, e-zone et MyPlace en local.",
    "de": "Steuern Sie Ihre Advantage Air MyAir-, e-zone- und MyPlace-Systeme lokal.",
    "es": "Controle localmente sus sistemas Advantage Air MyAir, e-zone y MyPlace."
  },
  "version": "0.0.0",
  "docker_image": "ghcr.io/gboulvin/gladys-advantage-air:0.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/gboulvin/Gladys-Advantage-Air/main/cover.jpg",
  "categories": ["climate", "lighting"],
  "keywords": ["advantage air", "myair", "e-zone", "myplace", "mylights", "mythings", "ducted"],
  "countries": ["AU", "NZ"],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "Getting started",
        "fr": "Pour commencer",
        "de": "Erste Schritte",
        "es": "Primeros pasos"
      },
      "description": {
        "en": "The integration talks to the Advantage Air wall tablet (MyAir, e-zone, MyPlace) over your local network: no account, no cloud. Give the tablet a fixed IP address in your router, keep the MyPlace / MyAir app running on it, and enter that address below.",
        "fr": "L'intégration dialogue avec la tablette murale Advantage Air (MyAir, e-zone, MyPlace) sur votre réseau local : pas de compte, pas de cloud. Donnez une adresse IP fixe à la tablette dans votre box, laissez l'application MyPlace / MyAir ouverte et saisissez cette adresse ci-dessous.",
        "de": "Die Integration kommuniziert über Ihr lokales Netzwerk mit dem Advantage-Air-Wandtablet (MyAir, e-zone, MyPlace): kein Konto, keine Cloud. Geben Sie dem Tablet in Ihrem Router eine feste IP-Adresse, lassen Sie die MyPlace-/MyAir-App darauf laufen und tragen Sie die Adresse unten ein.",
        "es": "La integración se comunica con la tableta de pared Advantage Air (MyAir, e-zone, MyPlace) a través de su red local: sin cuenta ni nube. Asigne una dirección IP fija a la tableta en su router, mantenga abierta la aplicación MyPlace / MyAir y escriba esa dirección abajo."
      },
      "links": [
        {
          "url": "https://www.advantageair.com.au/",
          "label": {
            "en": "Advantage Air website",
            "fr": "Site Advantage Air",
            "de": "Advantage-Air-Website",
            "es": "Sitio de Advantage Air"
          }
        }
      ]
    },
    {
      "key": "host",
      "type": "string",
      "label": {
        "en": "Tablet IP address",
        "fr": "Adresse IP de la tablette",
        "de": "IP-Adresse des Tablets",
        "es": "Dirección IP de la tableta"
      },
      "description": {
        "en": "Local IP address (or host name) of the Advantage Air wall tablet.",
        "fr": "Adresse IP locale (ou nom d'hôte) de la tablette murale Advantage Air.",
        "de": "Lokale IP-Adresse (oder Hostname) des Advantage-Air-Wandtablets.",
        "es": "Dirección IP local (o nombre de host) de la tableta de pared Advantage Air."
      },
      "placeholder": {
        "en": "e.g. 192.168.1.50",
        "fr": "ex. 192.168.1.50",
        "de": "z. B. 192.168.1.50",
        "es": "p. ej. 192.168.1.50"
      },
      "required": true
    },
    {
      "key": "port",
      "type": "number",
      "label": {
        "en": "Port",
        "fr": "Port",
        "de": "Port",
        "es": "Puerto"
      },
      "description": {
        "en": "Port of the local API of the tablet. Keep 2025 unless you know otherwise.",
        "fr": "Port de l'API locale de la tablette. Laissez 2025, sauf indication contraire.",
        "de": "Port der lokalen API des Tablets. Behalten Sie 2025, sofern nicht anders bekannt.",
        "es": "Puerto de la API local de la tableta. Mantenga 2025 salvo indicación contraria."
      },
      "required": false,
      "default": 2025,
      "min": 1,
      "max": 65535
    },
    {
      "key": "refresh_interval",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)",
        "de": "Aktualisierungsintervall (s)",
        "es": "Intervalo de actualización (s)"
      },
      "description": {
        "en": "How often the tablet is read, in seconds (5 to 300).",
        "fr": "Fréquence de lecture de la tablette, en secondes (5 à 300).",
        "de": "Wie oft das Tablet gelesen wird, in Sekunden (5 bis 300).",
        "es": "Frecuencia de lectura de la tableta, en segundos (5 a 300)."
      },
      "required": false,
      "default": 15,
      "min": 5,
      "max": 300
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test the connection",
        "fr": "Tester la connexion",
        "de": "Verbindung testen",
        "es": "Probar la conexión"
      },
      "description": {
        "en": "Read the tablet and list what was found.",
        "fr": "Lit la tablette et liste ce qui a été trouvé.",
        "de": "Liest das Tablet und listet die gefundenen Geräte auf.",
        "es": "Lee la tableta y enumera lo encontrado."
      },
      "timeout_seconds": 45
    }
  ],
